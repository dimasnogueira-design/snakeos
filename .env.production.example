NODE_ENV=production
PORT=8787
DATABASE_URL=postgresql://snake_os:change_me@localhost:5432/snake_os
DATABASE_SCHEMA=snake
DATABASE_SSL=true
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_NEGOTIATION=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
MOCK_AI=true
AI_DRY_RUN=true
AI_TEST_ONLY=true
AI_TEST_CONTACT_IDS=
AUTO_SEND=false
WHATSAPP_ENABLED=false
AUDIO_ENABLED=false
QA_APPROVED=false
AUTONOMOUS_AUTHORIZED=false
PROTECTED_CONTACT_NAMES=Rafaella
PROTECTED_CONTACT_IDS=
RAFAELLA_CONTACT_ID=
CALL_ALLOWLIST_IDS=
CONTEXT_RECENT_MESSAGES=16
OPENAI_MAX_OUTPUT_TOKENS=700
AI_CONTEXT_MAX_BYTES=12000
AI_TIMEOUT_MS=20000
AI_FAILURE_THRESHOLD=3
AI_DAILY_LIMIT_USD=0.10
AI_MONTHLY_LIMIT_USD=0.50
AI_SOFT_LIMIT_RATIO=0.8
SNAKE_ADMIN_KEY=change-me-before-production
